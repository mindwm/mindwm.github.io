    "spec": {
        "pipelineSpec": {
            "tasks": [
                {
                    "name": "copy-function-files",
                    "taskSpec": {
                        "metadata": {},
                        "spec": null,
                        "steps": [
                            {
                                "computeResources": {},
                                "image": "busybox",
                                "name": "copy-function-files",
                                "script": "#!/bin/sh\n                        find /workspace\n                        cp -vLr /workspace/source/* /workspace/build\n                        "
                            }
                        ]
                    },
                    "workspaces": [
                        {
                            "name": "source",
                            "workspace": "source"
                        },
                        {
                            "name": "build",
                            "workspace": "build"
                        }
                    ]
                },
                {
                    "name": "buildpack",
                    "params": [
                        {
                            "name": "REGISTRY_ENDPOINT",
                            "value": "zot-int.zot.svc.cluster.local:5000"
                        },
                        {
                            "name": "REPO",
                            "value": "context-cyan"
                        },
                        {
                            "name": "IMAGE",
                            "value": "yyy"
                        }
                    ],
                    "taskSpec": {
                        "metadata": {},
                        "spec": null,
                        "steps": [
                            {
                                "command": [
                                    "pack",
                                    "build",
                                    "$(params.REGISTRY_ENDPOINT)/$(params.REPO)/$(params.IMAGE):latest",
                                    "--builder",
                                    "gcr.io/buildpacks/builder:google-22",
                                    "--workspace",
                                    "/workspace/build",
                                    "--docker-host=inherit",
                                    "--publish"
                                ],
                                "computeResources": {},
                                "env": [
                                    {
                                        "name": "CNB_INSECURE_REGISTRIES",
                                        "value": "zot-int.zot:5000;zot.zot.svc.cluster.local:5000"
                                    }
                                ],
                                "image": "buildpacksio/pack:latest",
                                "name": "pack-build",
                                "securityContext": {
                                    "allowPrivilegeEscalation": true,
                                    "capabilities": {
                                        "add": [
                                            "ALL"
                                        ]
                                    },
                                    "privileged": true,
                                    "runAsGroup": 0,
                                    "runAsUser": 0
                                },
                                "volumeMounts": [
                                    {
                                        "mountPath": "/var/run/docker.sock",
                                        "name": "docker-socket"
                                    }
                                ],
                                "workingDir": "/workspace/build"
                            }
                        ],
                        "volumes": [
                            {
                                "hostPath": {
                                    "path": "/var/run/docker.sock",
                                    "type": "Socket"
                                },
                                "name": "docker-socket"
                            }
                        ]
                    },
                    "workspaces": [
                        {
                            "name": "source",
                            "workspace": "source"
                        },
                        {
                            "name": "build",
                            "workspace": "build"
                        }
                    ]
                }
            ],
