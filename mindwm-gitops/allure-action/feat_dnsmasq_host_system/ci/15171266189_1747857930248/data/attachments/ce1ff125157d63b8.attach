            "tasks": [
                {
                    "name": "copy",
                    "taskSpec": {
                        "metadata": {},
                        "spec": null,
                        "steps": [
                            {
                                "computeResources": {},
                                "image": "busybox",
                                "name": "copy-app-files",
                                "script": "#!/bin/sh\ncp -vLr /workspace/source/* /workspace/build\n"
